# 部署示例：把 wuchang-online 挂在主站的 /test/ 子路径下
#
# 说明：
#   - 本项目所有资源都用相对路径，strip_prefix 后能正确解析
#   - 页面通过 OTA 接口发现 WebSocket 地址，OTA 地址需可从浏览器访问
#   - 用子路径而不是根路径，避免和同域的设备 API 路径冲突
#
# 用法：把你的域名、证书路径、上游地址换成实际值。

example.com {
	tls /path/to/fullchain.pem /path/to/privkey.pem

	# ---- Web 测试页 ----
	handle /test/* {
		uri strip_prefix /test
		reverse_proxy wuchang-online:80
	}

	# ---- 同域的设备 API（如果你把 xiaozhi-server 也放在这个域）----
	# OTA 必须走 HTTP 端口（xiaozhi-server 默认 8003），
	# 不能走 WebSocket 端口（8000），否则返回 502/"EOF"
	handle /xiaozhi/ota/* {
		reverse_proxy xiaozhi-server:8003
	}

	# 设备 WebSocket，需要长超时
	handle /xiaozhi/v1/* {
		reverse_proxy xiaozhi-server:8000 {
			flush_interval -1
			transport http {
				read_timeout 24h
				write_timeout 24h
				dial_timeout 10s
			}
		}
	}

	handle {
		respond "wuchang-online" 200
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}
